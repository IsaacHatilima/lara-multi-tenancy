includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    # PHP_CodeSniffer loads its classes with its own autoloader, which config/insights.php needs.
    bootstrapFiles:
        - vendor/squizlabs/php_codesniffer/autoload.php

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
